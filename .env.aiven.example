# Copier dans .env.aiven et compléter depuis le service de FORMATION.
KAFKA_PROFILE=aiven
BOOTSTRAP_SERVERS=service-formation.example.aivencloud.com:12345
KAFKA_AUTH=sasl
KAFKA_CA_FILE=/certs/ca.pem
KAFKA_USERNAME=utilisateur-formation
KAFKA_PASSWORD=remplacer-localement
# Alternative mTLS : KAFKA_AUTH=mtls et certificats utilisateur.
KAFKA_CERT_FILE=/certs/service.cert
KAFKA_KEY_FILE=/certs/service.key
